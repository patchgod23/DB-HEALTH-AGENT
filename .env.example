# ──────────────────────────────────────────────────────────────────────────────
# db-health-agent — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────

# LLM Reasoning Layer (Optional but highly recommended)
# Supported providers: gemini, openai, openrouter
LLM_PROVIDER=openrouter
LLM_API_KEY=YOUR_OPENROUTER_OR_OTHER_API_KEY_HERE
LLM_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free

# Database Credentials
# The suffix (PROD_MAIN) must match the "id" defined in servers.yaml, converted to uppercase.
DB_PROD_MAIN_PASSWORD=your_secure_password_here
DB_BRANCH_NORTE_PASSWORD=your_secure_password_here
DB_WAREHOUSE_EAST_PASSWORD=your_secure_password_here

#Others db

# Sucursal Norte
DB_BRANCH_NORTE_HOST=
DB_BRANCH_NORTE_DATABASE=
DB_BRANCH_NORTE_USERNAME=
DB_BRANCH_NORTE_PASSWORD=
# Warehouse East
DB_WAREHOUSE_EAST_HOST=
DB_WAREHOUSE_EAST_DATABASE=
DB_WAREHOUSE_EAST_USERNAME=
DB_WAREHOUSE_EAST_PASSWORD=


# Agent Configuration (Defaults)
RUN_INTERVAL_SEC=60
LOG_DIR=logs

# API Configuration
API_PORT=8080
PROMETHEUS_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000
